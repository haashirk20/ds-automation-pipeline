# Copy to .env (gitignored). No real values here.

# --- Phase 1: scaffold ---
# 1 = everything except the publish call; unset or 0 = publish for real.
DRY_RUN=1
# Alerts: Discord webhook and/or Telegram bot.
ALERT_DISCORD_WEBHOOK=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# Dead-man's switch URL pinged every tick (healthchecks.io).
HEALTHCHECK_URL=
# pinged after the daily summary is delivered (Phase 6)
HEALTHCHECK_DAILY_URL=

# --- Phase 2: product intake and LLM ---
ANTHROPIC_API_KEY=
# my-store.myshopify.com (a full https:// URL is accepted)
SHOPIFY_SHOP=
# Optional: Admin API (scope read_products). Without both, the public feed is used.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Phase 3: rendering and video generation ---

# --- Phase 5: platform publishing ---
# Every platform publishes through the hosted bridge (Zernio); no per-platform keys.
BRIDGE_API_KEY=

# --- Phase 6: backups (restic to R2/S3) ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
