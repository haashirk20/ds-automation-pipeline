# Copy to .env.backup (gitignored). Read only by the `backup` service, never by the pipeline.
# Leave RESTIC_REPOSITORY empty and the service idles (docs/OWNER_SETUP.md, "Backups").

# Cloudflare R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<bucket>
RESTIC_REPOSITORY=
# Encrypts every backup. Keep a copy off the VM: without it a backup cannot be read.
RESTIC_PASSWORD=
# An R2 API token scoped to the one bucket (Object Read & Write).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
